---
layout: layout.njk
permalink: /reservation.html
seoKey: reservation
crumb: Tarifs et réservation
ldFaq: true
tags: pages
---
{%- set r = reservation -%}
    <section class="pagehead">
      <div class="wrap">
        <div>
          <p class="crumbs"><a href="index.html">Accueil</a> / Réservation</p>
          <p class="label">Tarifs &amp; réservation</p>
          <h1 class="display">{{ r.entete.titre | em | safe }}</h1>
        </div>
        <p class="lead">{{ r.entete.intro | mdi | safe }} Pour réserver, un appel au <a class="link" href="{{ site.telephone | telHref }}">{{ site.telephone }}</a> ou le formulaire en bas de page.</p>
      </div>
    </section>

    <section class="section" aria-labelledby="tarifs-title" style="padding-top:clamp(56px,7vw,96px)">
      <div class="wrap">
        <div class="sechead">
          <div>
            <p class="label">Tarifs</p>
            <h2 id="tarifs-title" class="h2">{{ r.formules.titre }}</h2>
          </div>
        </div>
        <div class="pricing">
          {%- for f in r.formules.liste %}
          <article class="plan{% if f.mise_en_avant %} plan--featured{% endif %}" style="--c:var(--{{ ['saffron', 'tomato', 'emerald', 'fuchsia', 'cobalt'] | cycle(loop.index) }})">
            {%- if f.mise_en_avant %}
            <span class="plan__tag">La plus choisie</span>
            {%- endif %}
            <span class="plan__bar"></span>
            <h3 class="h3">{{ f.nom }}</h3>
            <p class="plan__price">{{ f.prix }} €<small>TTC</small></p>
            <p class="plan__meta">{{ f.duree }}</p>
            <ul>
              {%- for i in f.inclus %}
              <li>{% icon "check" %}{{ i }}</li>
              {%- endfor %}
            </ul>
            <a class="btn{% if not f.mise_en_avant %} btn--outline{% endif %}" href="#demande">Choisir cette séance {% icon "arrow" %}</a>
          </article>
          {%- endfor %}
        </div>
        <div class="extras">
          {%- for o in r.formules.options %}
          <div><span>{{ o.nom }}</span><strong>{{ o.prix }}</strong></div>
          {%- endfor %}
        </div>
      </div>
    </section>

    <section class="section section--ink" aria-labelledby="deroule-title">
      <div class="wrap">
        <div class="sechead">
          <div>
            <p class="label">Modalités</p>
            <h2 id="deroule-title" class="h2">{{ r.modalites.titre | em | safe }}</h2>
          </div>
        </div>
        <ol class="steps">
          {%- for e in r.modalites.etapes %}
          <li><h3>{{ e.titre }}</h3><p>{{ e.texte }}</p></li>
          {%- endfor %}
        </ol>
      </div>
    </section>

    <section class="section" aria-labelledby="cond-title">
      <div class="wrap">
        <div class="sechead">
          <div>
            <p class="label">Conditions</p>
            <h2 id="cond-title" class="h2">{{ r.conditions.titre | em | safe }}</h2>
          </div>
        </div>
        <div class="terms">
          {%- for c in r.conditions.liste %}
          <div><h3>{{ c.titre }}</h3><p>{{ c.texte }}</p></div>
          {%- endfor %}
        </div>
      </div>
    </section>

    <section class="section section--alt" aria-labelledby="faq-title">
      <div class="wrap">
        <div class="sechead">
          <div>
            <p class="label">Questions fréquentes</p>
            <h2 id="faq-title" class="h2">{{ r.faq.titre | em | safe }}</h2>
          </div>
        </div>
        <div class="faq">
          {%- for q in r.faq.liste %}
          <details><summary>{{ q.question }}</summary>{{ q.reponse | md | safe }}</details>
          {%- endfor %}
        </div>
      </div>
    </section>

    <section class="section" id="demande" aria-labelledby="demande-title">
      <div class="wrap booking">
        <div>
          <p class="label">Demande de réservation</p>
          <h2 id="demande-title" class="h2" style="margin:22px 0 24px">{{ r.demande.titre | em | safe }}</h2>
          <p class="lead">{{ r.demande.intro }}</p>
          <div class="booking__direct">
            <a href="{{ site.telephone | telHref }}">{{ site.telephone }}</a>
            <a href="mailto:{{ site.email }}" style="font-size:1.4rem">{{ site.email }}</a>
          </div>
        </div>
        <form class="form" id="contact-form" novalidate data-email="{{ site.email }}">
          <label>Votre prénom<input name="prenom" autocomplete="given-name" required></label>
          <label>Téléphone<input name="tel" type="tel" autocomplete="tel"></label>
          <label class="form__full">E-mail<input name="email" type="email" autocomplete="email" required></label>
          <label>Nom et race du chien<input name="chien" required></label>
          <label>Formule
            <select name="seance">
              {%- for f in r.formules.liste %}
              <option>{{ f.nom }}</option>
              {%- endfor %}
              {%- for c in r.demande.autres_choix %}
              <option>{{ c }}</option>
              {%- endfor %}
            </select>
          </label>
          <label class="form__full">Votre message<textarea name="message" rows="3"></textarea></label>
          <button class="btn" type="submit">Envoyer ma demande {% icon "arrow" %}</button>
          <p class="form__note form__full" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
