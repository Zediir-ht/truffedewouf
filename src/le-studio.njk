---
layout: layout.njk
permalink: /le-studio.html
seoKey: studio
crumb: Le Studio
tags: pages
---
{%- set st = studio -%}
    <section class="pagehead">
      <div class="wrap">
        <div>
          <p class="crumbs"><a href="index.html">Accueil</a> / Le Studio</p>
          <p class="label">Le Studio</p>
          <h1 class="display">{{ st.entete.titre | em | safe }}</h1>
        </div>
        <p class="lead">{{ st.entete.intro }}</p>
      </div>
    </section>

    <section class="section">
      <div class="wrap studio-intro">
        {% ph { couleur: "caramel", cap: st.espace.legende, photo: st.espace.photo, alt: st.espace.alt or st.espace.legende, sizes: "(min-width: 860px) 50vw, 100vw" } %}
        <div>
          <p class="label">{{ st.espace.etiquette }}</p>
          <h2 class="h2" style="margin:22px 0 28px">{{ st.espace.titre | em | safe }}</h2>
          {{ st.espace.texte | md | safe }}
        </div>
      </div>
    </section>

    <section class="section section--ink" aria-labelledby="approche-title">
      <div class="wrap">
        <div class="sechead">
          <div>
            <p class="label">Les portraits</p>
            <h2 id="approche-title" class="h2">{{ st.approche.titre | em | safe }}</h2>
          </div>
        </div>
        <div class="principles">
          {%- for r in st.approche.regles %}
          <article><span>{{ loop.index | pad2 }}</span><h3 class="h3">{{ r.titre }}</h3><p>{{ r.texte }}</p></article>
          {%- endfor %}
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="bio-title">
      <div class="wrap bio">
        {% ph { couleur: "chocolat", cap: st.photographe.legende, photo: st.photographe.photo, alt: st.photographe.alt or st.photographe.legende, sizes: "(min-width: 860px) 40vw, 100vw" } %}
        <div class="bio__text">
          <p class="label">{{ st.photographe.etiquette }}</p>
          <h2 id="bio-title" class="h2" style="margin:22px 0 28px">{{ st.photographe.titre | em | safe }}</h2>
          {{ st.photographe.texte | md | safe }}
          {%- if st.photographe.signature %}
          <p class="bio__sign">{{ st.photographe.signature }}</p>
          {%- endif %}
        </div>
      </div>
    </section>

    <section class="section section--alt" id="domicile" aria-labelledby="dep-title">
      <div class="wrap">
        <div class="sechead">
          <div>
            <p class="label">Déplacements</p>
            <h2 id="dep-title" class="h2">{{ st.deplacements.titre | em | safe }}</h2>
          </div>
          <p class="lead" style="max-width:24em;margin:0">{{ st.deplacements.intro }}</p>
        </div>
        <ul class="places">
          {%- for l in st.deplacements.lieux %}
          <li><strong>{{ l.nom }}</strong><span>{{ l.detail }}</span></li>
          {%- endfor %}
        </ul>
      </div>
    </section>
{% include "reserver.njk" %}
